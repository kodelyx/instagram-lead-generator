{
  "manifest_version": 3,
  "name": "InstaLeads - Instagram Lead Generator",
  "version": "1.0.0",
  "description": "Extract emails, phone numbers, and contacts from Instagram followers, following lists, and profiles into CSV.",
  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "https://i.instagram.com/*",
    "https://www.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*"
  ],
  "action": {
    "default_title": "Open InstaLeads Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
